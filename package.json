{
  "name": "@civ-clone/worker-transport",
  "version": "0.1.1",
  "description": "A core-data-client transport over a web worker's messages: the page's end, to the worker it started, and the worker's end, to its page.",
  "repository": "git@github.com:civ-clone/worker-transport.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@types/chai": "^4.0",
    "@types/mocha": "^9.0",
    "@types/node": "^14.0",
    "chai": "^4.0",
    "mocha": "^9.0",
    "prettier": "^2.0",
    "ts-mocha": "^9.0",
    "typescript": "^4.0"
  },
  "dependencies": {
    "@civ-clone/core-data-client": "^0.1.1",
    "@civ-clone/core-data-object": "^0.1.17"
  }
}
